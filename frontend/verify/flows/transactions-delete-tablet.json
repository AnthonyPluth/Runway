{
  "name": "transactions-delete-tablet",
  "page": "transactions",
  "viewports": [
    "phone",
    "tablet"
  ],
  "steps": [
    {
      "goto": "#review"
    },
    {
      "click": "[data-tx] button[aria-label^=\"Details for \"]"
    },
    {
      "click": "button:has-text(\"Delete transaction\")"
    },
    {
      "expect_text": {
        "selector": "[data-slot=confirm-dialog]",
        "text": "A later bank sync may bring it back."
      }
    },
    {
      "screenshot": "confirm"
    },
    {
      "click": "[data-slot=confirm-dialog] button:has-text(\"Cancel\")"
    }
  ]
}
