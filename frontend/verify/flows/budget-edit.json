{
  "name": "budget-edit",
  "page": "budget",
  "steps": [
    { "wait_for": "button[aria-label^='Edit Coffee & Snacks budget']" },
    { "scroll_to": "button[aria-label^='Edit Coffee & Snacks budget']" },
    { "click": "button[aria-label^='Edit Coffee & Snacks budget']" },
    { "wait_for": "[data-budget-editor]" },
    { "expect_focus": "[data-budget-editor] input" },
    { "expect_text": { "selector": "[data-scope-note]", "text": "Used in months without their own amount" } },
    { "screenshot": "usual" },
    { "click": "[data-budget-editor] [role=radio]:has-text('This month only')" },
    { "expect_text": { "selector": "[data-scope-note]", "text": "only. Other months keep $60." } },
    { "screenshot": "this-month" },
    { "click": "[data-budget-editor] button:text-is('Cancel')" },
    { "click": "button[aria-label^='Edit Shopping budget']" },
    { "wait_for": "[data-budget-editor]" },
    { "expect_text": { "selector": "[data-scope-note]", "text": "only. Other months keep $300." } },
    { "screenshot": "own-month" },
    { "click": "[data-budget-editor] button:text-is('Cancel')" }
  ]
}
