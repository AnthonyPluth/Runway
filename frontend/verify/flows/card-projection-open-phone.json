{
  "name": "card-projection-open-phone",
  "page": "transactions",
  "steps": [
    { "click": "button[aria-label^='Show upcoming']" },
    { "click": "text=/^Show all \\d+/" },
    { "wait_for": "[data-projected] [role=button][aria-expanded=false]" },
    { "screenshot": "closed" },
    { "click": "[data-projected] [role=button][aria-expanded=false]" },
    { "wait_for": "[data-projected] [role=button][aria-expanded=true]" },
    { "expect_text": { "selector": "[data-projected]:has([role=button][aria-expanded=true])", "text": "Charged so far" } },
    { "screenshot": "open" }
  ],
  "viewports": ["phone"]
}
