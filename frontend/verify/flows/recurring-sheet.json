    {
      "click": "[data-recurring-sheet] >> text=Skip the next one"
    },
    {
      "wait_for": "[data-recurring-sheet] >> text=Put it back"
    },
    {
      "scroll_to": "[data-recurring-sheet] >> text=Put it back"
    },
    {
