{
  "manifest_version": 3,
  "name": "Runway: Amazon, Target and Carta",
  "short_name": "Runway",
  "version": "1.3.6",
  "description": "Sends your Amazon and Target orders and your Carta equity to your own Runway.",
  "permissions": [
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "webRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.amazon.com/*",
    "https://www.target.com/*",
    "https://api.target.com/*",
    "https://app.carta.com/*",
    "https://*.carta.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "page.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Runway orders",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "runway-orders@runway.local",
      "strict_min_version": "128.0"
    }
  }
}
