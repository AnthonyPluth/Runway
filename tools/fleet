#!/bin/bash
# vendored from fleet v1.0.0 (shim/fleet) by `fleet sync`; edit it in fleet, not here: `fleet drift` fails on any change
# The fleet command at the version in .fleet/version (the tag the workflow pins carry), run through uvx from fleet's
# repository, so the app runs exactly the tools its pins name. uv is installed the way the session-start hook does when
# it's missing.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
version=$(cat "$root/.fleet/version")
export PATH="$HOME/.local/bin:$PATH"
if ! command -v uvx >/dev/null 2>&1; then
  python3 -m pip install --quiet --user "uv==0.12.21"
fi
exec uvx --from "git+https://github.com/AnthonyPluth/fleet@$version" fleet "$@"
