# Copy to .env and fill in. Keep .env private (it holds your client secret).

# The address you'll open Runway at. Register <this>/auth/callback as a redirect URI with your provider,
# and <this>/auth/signed-out as the post-logout redirect URI.
RUNWAY_PUBLIC_URL=https://runway.example.com

# From your identity provider (Authentik, Authelia, Keycloak, Pocket ID, Google, Microsoft Entra, ...)
OIDC_ISSUER=https://auth.example.com/application/o/runway/
OIDC_CLIENT_ID=runway
OIDC_CLIENT_SECRET=

# Who may sign in: emails and/or groups (comma-separated). At least one is required.
OIDC_ALLOWED_EMAILS=you@example.com
OIDC_ALLOWED_GROUPS=
# Emails only count when your provider marks them verified. Set 1 only if yours never does and nobody can change
# their own email there (e.g. Microsoft Entra ID):
# OIDC_TRUST_UNVERIFIED_EMAIL=1
# Add "groups" here if your provider only sends group membership when asked:
OIDC_SCOPES=openid email profile

TZ=America/Chicago

# Encrypts the bank access and API keys Runway saves. A long random string: openssl rand -base64 32
# Keep a copy somewhere safe (a password manager): without it, saved connections have to be entered again.
# Left empty, Runway makes a key file in ./data (secret.key) instead.
RUNWAY_SECRET_KEY=

# Optional: Postgres instead of the built-in database. Leave empty to keep using the file in ./data.
# DATABASE_URL=postgresql://runway:password@db-host:5432/runway

# Optional: reports to Sentry (see DOCKER.md). Errors once SENTRY_DSN is set; everything else is off until you set it.
# SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<server project>
# SENTRY_BROWSER_DSN=https://<key>@o<org>.ingest.us.sentry.io/<web app project>
# SENTRY_TRACES_SAMPLE_RATE=0.2
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=0.2
# SENTRY_REPLAY_SAMPLE_RATE=0
# SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=1
# SENTRY_LOGS=1
# SENTRY_METRICS=1
# SENTRY_CRONS=1
# SENTRY_FEEDBACK=1
# SENTRY_AI_CONTENT=1
