# Copy to .env and fill in. Keep .env private (it holds your client secret).

# The address you'll open Runway at. Register <this>/auth/callback as a redirect URI with your provider,
# and <this>/auth/signed-out as the post-logout redirect URI.
RUNWAY_PUBLIC_URL=https://runway.example.com

# From your identity provider (Authentik, Authelia, Keycloak, Pocket ID, Google, Microsoft Entra, ...)
OIDC_ISSUER=https://auth.example.com/application/o/runway/
OIDC_CLIENT_ID=runway
OIDC_CLIENT_SECRET=

# Who may sign in: emails and/or groups (comma-separated). At least one is required.
OIDC_ALLOWED_EMAILS=anthony.pluth@imprint.co
OIDC_ALLOWED_GROUPS=
# Add "groups" here if your provider only sends group membership when asked:
OIDC_SCOPES=openid email profile

TZ=America/Chicago

# Optional: Postgres instead of the built-in database. Leave empty to keep using the file in ./data.
# DATABASE_URL=postgresql://runway:password@db-host:5432/runway
